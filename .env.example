# Local development only. Copy to .env; never commit actual credentials.
POSTGRES_DB=mitte
POSTGRES_USER=mitte
POSTGRES_PASSWORD=
# Required for direct `go run`; use the same password as POSTGRES_PASSWORD.
DATABASE_URL=

DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
PORT=8080
# For direct local execution. Compose binds this internally as :9090.
GRPC_LISTEN_ADDR=127.0.0.1:9090
APP_ENV=development
RUN_MIGRATIONS=true
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s

# Optional Stripe test-mode values for local checkout. Never put keys here;
# copy this file to the Git-ignored .env and fill only that local file.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Google Gemini key for natural-language shopping help. Without a key
# (or when Gemini is unavailable), the assistant still searches the live catalog.
# Gemini API projects typically require billing to be enabled.
GEMINI_API_KEY=
# Optional; defaults to gemini-3.8-flash
GEMINI_MODEL=
STRIPE_SUCCESS_URL=http://localhost:8080/bestellung/erfolg?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:8080/warenkorb
# First-party demo payment flow. It never processes real payment credentials.
MITTE_PAY_SANDBOX_ENABLED=true
# Generate a unique secret (at least 32 characters), e.g. `openssl rand -hex 32`.
MITTE_PAY_OTP_SECRET=
# First-party bank-transfer payment rail. This is reconciled by authorised
# staff in /zahlungen; it never accepts card data. Enable and supply verified
# account details through production secrets before offering it to customers.
MITTE_TRANSFER_ENABLED=true
MITTE_TRANSFER_RECIPIENT=Mitte Demo Handelsgesellschaft mbH
MITTE_TRANSFER_IBAN=DE00 0000 0000 0000 0000 00
# Development-only Billie-style invoice/factoring simulation. Never enable in production.
MITTE_INVOICE_SANDBOX_ENABLED=true
# Docker Compose sends local mail to Mailpit by default. To deliver real mail,
# set these to an SMTP provider that supports STARTTLS (normally port 587).
# Production refuses to deliver mail when the server does not offer STARTTLS.
# Keep credentials only in the ignored .env file or a production secret manager.
SMTP_ADDRESS=127.0.0.1:1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Optional observability-only copy of each successfully delivered message.
# In Docker development: SMTP_MIRROR_ADDRESS=mailpit:1025
SMTP_MIRROR_ADDRESS=
SMTP_MIRROR_USERNAME=
SMTP_MIRROR_PASSWORD=
SMTP_MIRROR_FROM=

KAFKA_BROKERS=localhost:9092
KAFKA_ORDER_TOPIC=mitte.orders.v1
# Local Compose Kafka uses plaintext; production order relays require TLS and SASL.
KAFKA_TLS_ENABLED=false
KAFKA_TLS_CA_CERT=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
ORDER_RELAY_ENABLED=false

# Private staff-only usernames and passwords for /oms, /verwaltung, /bestand,
# /zahlungen, and /admin/catalog. These are not customer accounts and do not
# need email addresses. Local development may use username:password pairs.
# Production requires Argon2id hashes: username:$argon2id$...,username:$argon2id$...
# Keep credentials only in the ignored .env or a production secret manager.
STAFF_CREDENTIALS=
# Assign every account a least-privilege role: username:role pairs, comma-separated.
# Roles: admin, operations, orders, warehouse, catalog, inventory, payments.
STAFF_ROLES=
# Separate supplier portal accounts. Each username maps to the exact supplier
# name assigned to products in the catalog. Production passwords must be
# Argon2id hashes; local development may use plaintext passwords.
# Format: username:supplier-name:password,username:supplier-name:password
SUPPLIER_CREDENTIALS=

# Bearer credential for the OMS integrations API (not the staff UI). The
# canonical OMS UI is served by the web app at /oms; never expose port 8081 publicly.
OMS_API_KEY=
OMS_USERNAME=operations
OMS_PASSWORD=

# Invoice issuer profile. Keep the DEMO values until legally verified details
# are available; OMS will clearly mark documents as demo in that case.
PUBLIC_BASE_URL=http://localhost:8080
INVOICE_SELLER_NAME=Mitte Demo Handelsgesellschaft mbH
INVOICE_SELLER_ADDRESS=Musterstrasse 12, 20095 Hamburg, Deutschland
INVOICE_SELLER_STREET=Musterstrasse 12
INVOICE_SELLER_POSTAL_CODE=20095
INVOICE_SELLER_CITY=Hamburg
INVOICE_SELLER_COUNTRY_CODE=DE
INVOICE_SELLER_VAT_ID=DE000000000
INVOICE_SELLER_EMAIL=rechnungen@mitte.demo
INVOICE_SELLER_IBAN=DE00 0000 0000 0000 0000 00
INVOICE_PAYMENT_TERMS=Bereits bezahlt via Stripe Checkout.
